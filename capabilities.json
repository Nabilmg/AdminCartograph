{
  "dataRoles": [
    {
      "displayName": "Admin1 PCODE",
      "name": "statePcode",
      "kind": "Grouping",
      "description": "Field that uniquely identifies an Admin1 area (state / province / governorate). Must match ADM1_PCODE in the embedded geometry."
    },
    {
      "displayName": "Admin2 PCODE",
      "name": "localityPcode",
      "kind": "Grouping",
      "description": "Field that uniquely identifies an Admin2 area (locality / district). Must match ADM2_PCODE in the embedded geometry."
    },
    {
      "displayName": "Choropleth fill",
      "name": "colorValue",
      "kind": "Measure",
      "description": "Measure used to colour the choropleth (the fill of each Admin1 / Admin2 polygon)."
    },
    {
      "displayName": "Bubble Size",
      "name": "bubbleSize",
      "kind": "Measure",
      "description": "Measure used to scale proportional bubbles."
    },
    {
      "displayName": "Glyph Values (pie / column)",
      "name": "glyphValues",
      "kind": "Measure",
      "description": "Two or more measures to render as a pie or column chart per area. Each measure becomes one slice / column."
    },
    {
      "displayName": "Label Value 2",
      "name": "labelValue2",
      "kind": "Measure",
      "description": "Optional secondary numeric value displayed in the label."
    },
    {
      "displayName": "Label Text 1",
      "name": "labelText1",
      "kind": "Grouping",
      "description": "Optional override for the area name displayed in labels."
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra fields shown in the tooltip."
    }
  ],

  "dataViewMappings": [
    {
      "conditions": [
        { "statePcode": { "max": 1 }, "localityPcode": { "max": 1 }, "colorValue": { "max": 1 }, "bubbleSize": { "max": 1 }, "labelValue2": { "max": 1 }, "labelText1": { "max": 1 } }
      ],
      "categorical": {
        "categories": {
          "select": [
            { "bind": { "to": "statePcode" } },
            { "bind": { "to": "localityPcode" } },
            { "bind": { "to": "labelText1" } }
          ]
        },
        "values": {
          "select": [
            { "bind": { "to": "colorValue" } },
            { "bind": { "to": "bubbleSize" } },
            { "bind": { "to": "labelValue2" } },
            { "for": { "in": "glyphValues" } },
            { "bind": { "to": "tooltips" } }
          ]
        }
      }
    }
  ],

  "objects": {
    "general": {
      "properties": {
        "selectedCountry": {
          "displayName": "Country",
          "description": "Pick a bundled country, leave on Auto-detect (uses PCODE prefix), or pick Custom and upload a TopoJSON.",
          "type": { "text": true }
        },
        "customAdm1Json": {
          "displayName": "Custom Admin1 (uploaded)",
          "description": "Populated by the upload UI. TopoJSON or GeoJSON for Admin1 boundaries.",
          "type": { "text": true }
        },
        "customAdm2Json": {
          "displayName": "Custom Admin2 (uploaded)",
          "description": "Populated by the upload UI. Optional TopoJSON or GeoJSON for Admin2 boundaries.",
          "type": { "text": true }
        },
        "customFieldMapping": {
          "displayName": "Custom field mapping",
          "description": "JSON: { adm1Pcode, adm1Name, adm2Pcode, adm2Name } — which property names from the uploaded files map to PCODE / display name.",
          "type": { "text": true }
        },
        "customTopoName": {
          "displayName": "Custom dataset name",
          "type": { "text": true }
        },
        "viewMode": {
          "displayName": "View mode",
          "type": {
            "enumeration": [
              { "value": "auto", "displayName": "Auto" },
              { "value": "states", "displayName": "Admin1" },
              { "value": "localities", "displayName": "Admin2" }
            ]
          }
        },
        "interactionEnabled": {
          "displayName": "Interaction enabled",
          "type": { "bool": true }
        },
        "hideUnfilteredStates": {
          "displayName": "Hide unfiltered Admin1 in Admin2 mode",
          "type": { "bool": true }
        },
        "hideMapChrome": {
          "displayName": "Hide map chrome",
          "description": "Hide the back button + arrow nav in drill view AND the on-canvas controls (zoom / pan / SVG export). Useful for clean, dashboard-style embeds.",
