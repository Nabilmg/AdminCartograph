{
  "dataRoles": [
    {
      "displayName": "Admin1 PCODE",
      "name": "statePcode",
      "kind": "Grouping",
      "description": "Field that uniquely identifies an Admin1 area (state / province / governorate). Must match ADM1_PCODE in the embedded geometry."
    },
    {
      "displayName": "Admin2 PCODE",
      "name": "localityPcode",
      "kind": "Grouping",
      "description": "Field that uniquely identifies an Admin2 area (locality / district). Must match ADM2_PCODE in the embedded geometry."
    },
    {
      "displayName": "Color Value",
      "name": "colorValue",
      "kind": "Measure",
      "description": "Measure used to color the choropleth fills."
    },
    {
      "displayName": "Bubble Size",
      "name": "bubbleSize",
      "kind": "Measure",
      "description": "Measure used to scale proportional bubbles."
    },
    {
      "displayName": "Label Value 2",
      "name": "labelValue2",
      "kind": "Measure",
      "description": "Optional secondary numeric value displayed in the label."
    },
    {
      "displayName": "Label Text 1",
      "name": "labelText1",
      "kind": "Grouping",
      "description": "Optional override for the area name displayed in labels."
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra fields shown in the tooltip."
    }
  ],

  "dataViewMappings": [
    {
      "conditions": [
        { "statePcode": { "max": 1 }, "localityPcode": { "max": 1 }, "colorValue": { "max": 1 }, "bubbleSize": { "max": 1 }, "labelValue2": { "max": 1 }, "labelText1": { "max": 1 } }
      ],
      "categorical": {
        "categories": {
          "select": [
            { "bind": { "to": "statePcode" } },
            { "bind": { "to": "localityPcode" } },
            { "bind": { "to": "labelText1" } }
          ]
        },
        "values": {
          "select": [
            { "bind": { "to": "colorValue" } },
            { "bind": { "to": "bubbleSize" } },
            { "bind": { "to": "labelValue2" } },
            { "bind": { "to": "tooltips" } }
          ]
        }
      }
    }
  ],

  "objects": {
