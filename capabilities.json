        "admin1Alias": {
          "displayName": "Admin1 alias",
          "description": "Override the 'Admin1' label in tooltips with your own term — e.g. Governorate, State, Region, Province. Empty = use 'Admin1'.",
          "type": { "text": true }
        },
        "admin2Alias": {
          "displayName": "Admin2 alias",
          "description": "Override the 'Admin2' label in tooltips with your own term — e.g. District, Locality, County, Municipality. Empty = use 'Admin2'.",
          "type": { "text": true }
        },
        "background": {
          "displayName": "Background color",
          "type": { "fill": { "solid": { "color": true } } }
